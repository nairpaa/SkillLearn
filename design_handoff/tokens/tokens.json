{
  "$description": "SkillLearn design tokens (W3C Design Tokens format). Imported by figma/plugin and mirrored in tokens.css / theme.ts.",
  "color": {
    "primary": {
      "default": { "$type": "color", "$value": "#0E5E52", "$description": "Brand teal: primary buttons, active nav, links" },
      "hover": { "$type": "color", "$value": "#0B4D43", "$description": "Primary hover (web) / pressed (mobile)" },
      "busy": { "$type": "color", "$value": "#4F8C82", "$description": "Primary button while request is in flight" },
      "tint": { "$type": "color", "$value": "#E7F3F0", "$description": "Selected rows, success banners, chip background" },
      "border": { "$type": "color", "$value": "#9FC5BC", "$description": "Card hover border, auth-guard nodes" },
      "on-dark": { "$type": "color", "$value": "#CFE6E0", "$description": "Secondary text on primary background" }
    },
    "accent": {
      "default": { "$type": "color", "$value": "#F2A93B", "$description": "Avatar, progress fill, logo dot, Run button" },
      "tint": { "$type": "color", "$value": "#FBF3DF", "$description": "Info / warning banners, new-user card, inline code bg" },
      "border": { "$type": "color", "$value": "#F0E2B8" },
      "ink": { "$type": "color", "$value": "#7A5510", "$description": "Text on accent tint, inline code text" },
      "ink-strong": { "$type": "color", "$value": "#5E420C" }
    },
    "ink": {
      "default": { "$type": "color", "$value": "#16211F", "$description": "Primary text, dark surfaces (code, video, phone bezel)" },
      "body": { "$type": "color", "$value": "#2E3A38", "$description": "Long-form paragraph text" },
      "muted": { "$type": "color", "$value": "#4A5856", "$description": "Secondary text (4.5:1+ on white)" },
      "subtle": { "$type": "color", "$value": "#8A9693", "$description": "Placeholders, captions on white (large/aux only)" }
    },
    "line": {
      "default": { "$type": "color", "$value": "#E3E8E6", "$description": "Card borders, dividers, skeleton blocks" },
      "strong": { "$type": "color", "$value": "#D5DDDA", "$description": "Input + secondary button borders" },
      "soft": { "$type": "color", "$value": "#EEF1F0", "$description": "Row separators, neutral chips" },
      "control": { "$type": "color", "$value": "#B9C4C1", "$description": "Unchecked checkbox border" },
      "dashed": { "$type": "color", "$value": "#C9D3D0", "$description": "Empty-state dashed border" }
    },
    "surface": {
      "page": { "$type": "color", "$value": "#F6F8F7", "$description": "App background" },
      "card": { "$type": "color", "$value": "#FFFFFF" },
      "desk": { "$type": "color", "$value": "#E3E8E6", "$description": "Area around the 390px mobile column on desktop browsers" },
      "overlay": { "$type": "color", "$value": "#16211F73", "$description": "Dialog / bottom-sheet scrim (ink at 45%)" }
    },
    "danger": {
      "default": { "$type": "color", "$value": "#C2412D", "$description": "Field error border + message, destructive button" },
      "hover": { "$type": "color", "$value": "#A33522" },
      "ink": { "$type": "color", "$value": "#9A3322", "$description": "Text on danger tint" },
      "tint": { "$type": "color", "$value": "#FBE9E5", "$description": "Error banner background" },
      "field": { "$type": "color", "$value": "#FFF8F6", "$description": "Invalid input background" }
    },
    "category": {
      "programming-tint": { "$type": "color", "$value": "#DCE8F7" },
      "programming-ink": { "$type": "color", "$value": "#1F4E8C" },
      "design-tint": { "$type": "color", "$value": "#F8E3DA" },
      "design-ink": { "$type": "color", "$value": "#A4472A" },
      "marketing-tint": { "$type": "color", "$value": "#F6ECCF" },
      "marketing-ink": { "$type": "color", "$value": "#7A5510" },
      "technology-tint": { "$type": "color", "$value": "#DCEEE3" },
      "technology-ink": { "$type": "color", "$value": "#2D6B4A" }
    },
    "code": {
      "bg": { "$type": "color", "$value": "#16211F" },
      "text": { "$type": "color", "$value": "#E7F3F0" },
      "comment": { "$type": "color", "$value": "#8A9693" },
      "string": { "$type": "color", "$value": "#9FD8C6" },
      "tag": { "$type": "color", "$value": "#8FB8F0" },
      "keyword": { "$type": "color", "$value": "#F2A93B" },
      "function": { "$type": "color", "$value": "#E9D59A" },
      "attribute": { "$type": "color", "$value": "#F4B9A4" },
      "punctuation": { "$type": "color", "$value": "#B9C4C1" },
      "line-number": { "$type": "color", "$value": "#5E6E6B" }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": "Plus Jakarta Sans" },
      "mono": { "$type": "fontFamily", "$value": "JetBrains Mono" }
    }
  },
  "typography": {
    "display": { "$type": "typography", "$value": { "fontFamily": "Plus Jakarta Sans", "fontWeight": 800, "fontSize": "40px", "lineHeight": 1.1, "letterSpacing": "-0.02em" }, "$description": "Auth side-panel headline (web)" },
    "page-title-lg": { "$type": "typography", "$value": { "fontFamily": "Plus Jakarta Sans", "fontWeight": 800, "fontSize": "34px", "lineHeight": 1.2, "letterSpacing": "-0.02em" }, "$description": "Web Home greeting, Article title" },
    "page-title": { "$type": "typography", "$value": { "fontFamily": "Plus Jakarta Sans", "fontWeight": 800, "fontSize": "30px", "lineHeight": 1.2, "letterSpacing": "-0.02em" }, "$description": "Web page titles (Search, Course Detail, Edit Profile)" },
    "screen-title": { "$type": "typography", "$value": { "fontFamily": "Plus Jakarta Sans", "fontWeight": 800, "fontSize": "28px", "lineHeight": 1.2, "letterSpacing": "-0.02em" }, "$description": "Auth form titles, mobile screen titles" },
    "mobile-title": { "$type": "typography", "$value": { "fontFamily": "Plus Jakarta Sans", "fontWeight": 800, "fontSize": "24px", "lineHeight": 1.2, "letterSpacing": "-0.02em" }, "$description": "Mobile tab-root titles (Search, Profile, Home name)" },
    "section": { "$type": "typography", "$value": { "fontFamily": "Plus Jakarta Sans", "fontWeight": 700, "fontSize": "22px", "lineHeight": 1.3, "letterSpacing": "-0.01em" }, "$description": "Web section headings" },
    "heading": { "$type": "typography", "$value": { "fontFamily": "Plus Jakarta Sans", "fontWeight": 700, "fontSize": "18px", "lineHeight": 1.35 }, "$description": "Card headings, mobile section headings" },
    "title": { "$type": "typography", "$value": { "fontFamily": "Plus Jakarta Sans", "fontWeight": 700, "fontSize": "16px", "lineHeight": 1.35 }, "$description": "Course card title, list titles" },
    "body-lg": { "$type": "typography", "$value": { "fontFamily": "Plus Jakarta Sans", "fontWeight": 400, "fontSize": "16px", "lineHeight": 1.7 }, "$description": "Article paragraphs" },
    "body": { "$type": "typography", "$value": { "fontFamily": "Plus Jakarta Sans", "fontWeight": 400, "fontSize": "15px", "lineHeight": 1.6 }, "$description": "Default body; inputs (mobile uses 16px to prevent iOS zoom)" },
    "ui": { "$type": "typography", "$value": { "fontFamily": "Plus Jakarta Sans", "fontWeight": 600, "fontSize": "14px", "lineHeight": 1.45 }, "$description": "Buttons, nav links, lesson titles" },
    "small": { "$type": "typography", "$value": { "fontFamily": "Plus Jakarta Sans", "fontWeight": 500, "fontSize": "13px", "lineHeight": 1.5 }, "$description": "Meta lines, field labels (600), chips" },
    "caption": { "$type": "typography", "$value": { "fontFamily": "Plus Jakarta Sans", "fontWeight": 600, "fontSize": "12px", "lineHeight": 1.45 }, "$description": "Field error messages, hints" },
    "tab": { "$type": "typography", "$value": { "fontFamily": "Plus Jakarta Sans", "fontWeight": 600, "fontSize": "11px", "lineHeight": 1.3 }, "$description": "Mobile tab-bar labels" },
    "eyebrow": { "$type": "typography", "$value": { "fontFamily": "JetBrains Mono", "fontWeight": 500, "fontSize": "11px", "lineHeight": 1.3, "letterSpacing": "0.08em", "textTransform": "uppercase" }, "$description": "Uppercase labels: CONTINUE LEARNING, LESSON 2 · ARTICLE" },
    "code": { "$type": "typography", "$value": { "fontFamily": "JetBrains Mono", "fontWeight": 500, "fontSize": "14px", "lineHeight": 1.7 }, "$description": "Code blocks (13.5px editor, 11.5px mobile)" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" }, "1-5": { "$type": "dimension", "$value": "6px" },
    "2": { "$type": "dimension", "$value": "8px" }, "2-5": { "$type": "dimension", "$value": "10px" },
    "3": { "$type": "dimension", "$value": "12px" }, "3-5": { "$type": "dimension", "$value": "14px" },
    "4": { "$type": "dimension", "$value": "16px" }, "4-5": { "$type": "dimension", "$value": "18px" },
    "5": { "$type": "dimension", "$value": "20px" }, "6": { "$type": "dimension", "$value": "24px" },
    "7": { "$type": "dimension", "$value": "28px" }, "8": { "$type": "dimension", "$value": "32px" },
    "9": { "$type": "dimension", "$value": "36px" }, "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" }, "14": { "$type": "dimension", "$value": "56px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "6px", "$description": "Inline code, small tags" },
    "sm": { "$type": "dimension", "$value": "8px", "$description": "Chips in editor, small buttons" },
    "md": { "$type": "dimension", "$value": "10px", "$description": "Web inputs + buttons, thumbnails" },
    "lg": { "$type": "dimension", "$value": "12px", "$description": "Mobile inputs + buttons, banners, code blocks" },
    "xl": { "$type": "dimension", "$value": "14px", "$description": "Course cards, list cards" },
    "2xl": { "$type": "dimension", "$value": "16px", "$description": "Panels, continue card, dialogs" },
    "sheet": { "$type": "dimension", "$value": "20px", "$description": "Bottom sheet top corners" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "size": {
    "web-nav": { "$type": "dimension", "$value": "68px" },
    "web-content-max": { "$type": "dimension", "$value": "1200px" },
    "web-gutter": { "$type": "dimension", "$value": "40px" },
    "web-control": { "$type": "dimension", "$value": "48px", "$description": "Primary input/button height (secondary 42–44)" },
    "mobile-width": { "$type": "dimension", "$value": "390px" },
    "mobile-status-bar": { "$type": "dimension", "$value": "50px" },
    "mobile-tab-bar": { "$type": "dimension", "$value": "84px" },
    "mobile-input": { "$type": "dimension", "$value": "52px" },
    "mobile-button": { "$type": "dimension", "$value": "54px" },
    "touch-min": { "$type": "dimension", "$value": "44px" }
  },
  "shadow": {
    "card-hover": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px", "color": "#0E5E521A" } },
    "tile-hover": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "14px", "spread": "0px", "color": "#0E5E5214" } },
    "dialog": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "20px", "blur": "50px", "spread": "0px", "color": "#00000033" } },
    "toast": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px", "color": "#00000033" } }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "150ms", "$description": "Hover/pressed transitions (background, border, shadow, transform)" },
    "progress": { "$type": "duration", "$value": "300ms", "$description": "Quiz progress bar width" },
    "spinner": { "$type": "duration", "$value": "800ms", "$description": "One full spinner rotation, linear, infinite" },
    "toast": { "$type": "duration", "$value": "3500ms", "$description": "Toast auto-dismiss" }
  }
}
