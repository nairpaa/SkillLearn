# Salin jadi .env lalu isi. Jangan pernah commit file .env.
NODE_ENV=development
PORT=8080

# Lokal: MongoDB Docker/lokal. Production: connection string MongoDB Atlas (user khusus aplikasi).
MONGODB_URI=mongodb://127.0.0.1:27017/skilllearn

# Kunci PASETO v4.public (Ed25519). Buat dengan: npm run keys
PASETO_SECRET_KEY=
PASETO_PUBLIC_KEY=
PASETO_KID=k1
# Kunci HMAC untuk rotasi refresh token (terpisah dari kunci PASETO). Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REFRESH_TOKEN_SECRET=
# Opsional saat rotasi kunci: kunci publik lama yang masih diterima, format kid=k4.public.xxx
PASETO_PREVIOUS_PUBLIC_KEYS=

# Origin web yang diizinkan (CORS + cek Origin saat refresh). Pisahkan dengan koma.
APP_ORIGIN=http://localhost:5173
# Alamat web untuk link di email verifikasi/reset. Default: origin pertama di APP_ORIGIN.
APP_URL=

# Berapa lapis proxy di depan server (untuk membaca IP asli). Lokal: loopback. Render/Vercel: 1.
# Cek setelah deploy: field clientIp di /api/health harus sama dengan IP publikmu.
TRUST_PROXY=loopback

# Rahasia bersama dengan function proxy web (web/api/proxy.js). Harus SAMA persis dengan
# PROXY_SHARED_SECRET di project Vercel web. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Kosong = header IP dari proxy diabaikan (aman untuk lokal, karena web lokal memakai proxy Vite).
PROXY_SHARED_SECRET=

# Email. Isi salah satu. Kalau dua-duanya kosong, link dicetak di log server (khusus development).
RESEND_API_KEY=
# Contoh Gmail: smtps://alamat%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=SkillLearn <onboarding@resend.dev>

# Akun yang dibuat oleh npm run seed.
# Production: DEMO_PASSWORD WAJIB diisi password pribadi (bukan Belajar123 yang tertulis di README),
# lalu bagikan ke penguji lewat dokumen tugas saja.
ADMIN_EMAIL=admin@skilllearn.id
ADMIN_PASSWORD=
DEMO_PASSWORD=Belajar123
