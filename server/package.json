{
  "name": "skilllearn-server",
  "version": "1.0.0",
  "description": "REST API SkillLearn: auth PASETO, course & lesson, kuis, favorit, riwayat (Express + MongoDB)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/seed/seed.js",
    "keys": "node src/scripts/generate-keys.js",
    "test:security": "node src/scripts/security-test.js",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-exclude=\"src/seed/**\" --test-coverage-exclude=\"src/scripts/**\" \"test/**/*.test.js\""
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.0",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.0",
    "nodemailer": "^10.4.0",
    "paseto": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
